#: src/cinnamon_clipboard/ui/welcome_window.py:147
msgid ""
"This quick setup will help you configure your clipboard history, choose how "
"many items to keep, and decide whether the app starts automatically when you"
" log in."
msgstr ""
"Cette configuration rapide vous aide à définir l’historique du presse-"
"papiers, choisir le nombre d’éléments à conserver et décider si "
"l’application démarre automatiquement à l’ouverture de session."

#: src/cinnamon_clipboard/ui/welcome_window.py:159
msgid "You can skip this setup and use the default settings."
msgstr "Vous pouvez ignorer cette configuration et utiliser les réglages par défaut."

#: src/cinnamon_clipboard/ui/welcome_window.py:171
msgid "Choose your history mode"
msgstr "Choisissez le mode d’historique"

#: src/cinnamon_clipboard/ui/welcome_window.py:173
msgid ""
"Choose whether your clipboard history should be preserved after closing the "
"application."
msgstr ""
"Choisissez si votre historique du presse-papiers doit être conservé après la"
" fermeture de l’application."

#: src/cinnamon_clipboard/ui/welcome_window.py:230
msgid "History limit"
msgstr "Limite de l’historique"

#: src/cinnamon_clipboard/ui/welcome_window.py:231
msgid "Choose the maximum number of unpinned history items."
msgstr "Choisissez le nombre maximal d’éléments non épinglés de l’historique."

#: src/cinnamon_clipboard/ui/welcome_window.py:253
msgid "Maximum history items:"
msgstr "Nombre maximal d’éléments :"

#: src/cinnamon_clipboard/ui/welcome_window.py:263
msgid "This limit applies only to unpinned items."
msgstr "Cette limite ne s’applique qu’aux éléments non épinglés."

#: src/cinnamon_clipboard/ui/welcome_window.py:274
msgid "Start automatically"
msgstr "Démarrer automatiquement"

#: src/cinnamon_clipboard/ui/welcome_window.py:276
msgid "Choose whether Cinnamon Clipboard should start automatically when you log in."
msgstr ""
"Choisissez si Cinnamon Clipboard doit démarrer automatiquement à l’ouverture"
" de session."

#: src/cinnamon_clipboard/ui/welcome_window.py:282
msgid "Start Cinnamon Clipboard automatically on login"
msgstr "Démarrer Cinnamon Clipboard automatiquement à l’ouverture de session"

#: src/cinnamon_clipboard/ui/welcome_window.py:303
msgid "Finish"
msgstr "Terminer"

#: src/cinnamon_clipboard/ui/welcome_window.py:365
msgid "Unable to save settings"
msgstr "Impossible d’enregistrer les réglages"

#: src/cinnamon_clipboard/ui/welcome_window.py:369
msgid "Your settings could not be saved. Please try again."
msgstr "Vos réglages n’ont pas pu être enregistrés. Veuillez réessayer."

