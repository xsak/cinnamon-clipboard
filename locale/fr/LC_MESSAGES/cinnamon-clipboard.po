msgstr "Image (%(width)d × %(height)d px)"

msgid ""
"Only some files were added to the clipboard because some are no longer "
"available."
msgstr ""
"Seuls certains fichiers ont été ajoutés au presse-papiers, car d’autres ne "
"sont plus disponibles."

msgid "The file is no longer available for copying."
msgstr "Ce fichier n’est plus disponible pour être copié."

#, python-format
msgid "%(count)d files are no longer available for copying."
msgstr "%(count)d fichiers ne sont plus disponibles pour être copiés."

msgid "Cinnamon Clipboard"
msgstr "Presse-papiers Cinnamon"

#, python-format
msgid "File: %(name)s"
msgstr "Fichier : %(name)s"

#, python-format
msgid "%(name)s and %(count)d more file(s)"
msgstr "%(name)s et %(count)d autre(s) fichier(s)"

msgid "The image is no longer available for copying."
msgstr "Cette image n’est plus disponible pour être copiée."

msgid "The image could not be copied."
msgstr "L’image n’a pas pu être copiée."

msgid "Clipboard manager for Linux desktops."
msgstr "Gestionnaire de presse-papiers pour les bureaux Linux."

