msgstr "Voir la version"

#: src/cinnamon_clipboard/ui/preferences_window.py:549
msgid "Click to assign"
msgstr "Cliquer pour attribuer"

#: src/cinnamon_clipboard/ui/preferences_window.py:554
msgid "Press a key combination..."
msgstr "Appuyez sur une combinaison de touches…"

#: src/cinnamon_clipboard/ui/preferences_window.py:598
msgid "Switch to temporary history?"
msgstr "Passer à l’historique temporaire ?"

#: src/cinnamon_clipboard/ui/preferences_window.py:600
msgid ""
"The saved clipboard history database and its images will be permanently "
"deleted. The application will restart with an empty history stored only in "
"memory."
msgstr ""
"La base de données de l’historique enregistré du presse-papiers et ses "
"images seront définitivement supprimées. L’application redémarrera avec un "
"historique vide stocké uniquement en mémoire."

#: src/cinnamon_clipboard/ui/preferences_window.py:605
msgid "Delete history and switch"
msgstr "Supprimer l’historique et changer de mode"

#: src/cinnamon_clipboard/ui/preferences_window.py:607
msgid "Switch to persistent history?"
msgstr "Passer à l’historique persistant ?"

#: src/cinnamon_clipboard/ui/preferences_window.py:609
msgid ""
"The temporary history will be lost when the application restarts. Persistent"
" history will start empty."
msgstr ""
"L’historique temporaire sera perdu au redémarrage de l’application. "
"L’historique persistant démarrera vide."

#: src/cinnamon_clipboard/ui/preferences_window.py:613
msgid "Restart and switch"
msgstr "Redémarrer et changer de mode"

#: src/cinnamon_clipboard/ui/preferences_window.py:642
msgid "Could not delete the saved history"
msgstr "Impossible de supprimer l’historique enregistré."

#: src/cinnamon_clipboard/ui/preferences_window.py:646
msgid ""
"The history mode has not been changed. Check the file permissions and try "
"again."
msgstr ""
"Le mode d’historique n’a pas été modifié. Vérifiez les permissions des "
"fichiers et réessayez."

#: src/cinnamon_clipboard/ui/preferences_window.py:662
msgid "Could not save preferences"
msgstr "Impossible d’enregistrer les préférences."

#: src/cinnamon_clipboard/ui/preferences_window.py:666
msgid "The preferences could not be saved. Check the file permissions and try again."
msgstr ""
"Impossible d’enregistrer les préférences. Vérifiez les permissions des "
"fichiers et réessayez."

#: src/cinnamon_clipboard/ui/welcome_window.py:20
#: src/cinnamon_clipboard/ui/welcome_window.py:138
