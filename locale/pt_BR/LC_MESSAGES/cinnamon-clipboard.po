msgstr "Imagem (%(width)d × %(height)d px)"

#: src/cinnamon_clipboard/core/clipboard.py:399
msgid ""
"Only some files were added to the clipboard because some are no longer "
"available."
msgstr ""
"Somente alguns arquivos foram adicionados à área de transferência porque os "
"demais não estão mais disponíveis."

#: src/cinnamon_clipboard/core/clipboard.py:402
msgid "The file is no longer available for copying."
msgstr "O arquivo não está mais disponível para cópia."

#: src/cinnamon_clipboard/core/clipboard.py:405
#, python-format
msgid "%(count)d files are no longer available for copying."
msgstr "%(count)d arquivos não estão mais disponíveis para cópia."

