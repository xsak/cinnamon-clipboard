#: src/cinnamon_clipboard/ui/preferences_window.py:159
#: src/cinnamon_clipboard/ui/welcome_window.py:190
msgid ""
"The history is stored in an SQLite database on disk, along with images. "
"Items are preserved when closing the application or restarting the PC."
msgstr ""
"O histórico é armazenado em um banco de dados SQLite no disco, junto com as "
"imagens. Os itens são preservados ao fechar o aplicativo ou reiniciar o PC."

#: src/cinnamon_clipboard/ui/preferences_window.py:172
#: src/cinnamon_clipboard/ui/welcome_window.py:209
msgid ""
"The history is kept in RAM and is lost when closing the application or "
"shutting down or restarting the PC. No persistent copy of the history is "
"saved to disk."
msgstr ""
"O histórico é mantido na memória RAM e é perdido ao fechar o aplicativo ou "
"desligar ou reiniciar o PC. Nenhuma cópia persistente do histórico é salva "
"no disco."

#: src/cinnamon_clipboard/ui/preferences_window.py:195
msgid "History limit:"
msgstr "Limite do histórico:"

#: src/cinnamon_clipboard/ui/preferences_window.py:261
msgid "Applies only to unpinned items."
msgstr "Aplica-se apenas a itens não fixados."

#: src/cinnamon_clipboard/ui/preferences_window.py:281
msgid "Capture images:"
msgstr "Salvar imagens:"

#: src/cinnamon_clipboard/ui/preferences_window.py:297
msgid "Capture files and folders:"
msgstr "Salvar arquivos e pastas:"

