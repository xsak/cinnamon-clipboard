msgid "Temporary history could not be started"
msgstr "Não foi possível iniciar o histórico temporário."

msgid ""
"The saved clipboard history could not be deleted. Check file permissions and "
"restart the application."
msgstr ""
"Não foi possível excluir o histórico salvo da área de transferência. "
"Verifique as permissões dos arquivos e reinicie o aplicativo."

msgid "Configuration restored"
msgstr "Configuração restaurada"

msgid ""
"The configuration file contained invalid data and was reset to the default "
"values."
msgstr ""
"O arquivo de configuração continha dados inválidos e foi redefinido para os "
"valores padrão."

msgid "Automatic startup could not be configured"
msgstr "Não foi possível configurar a inicialização automática"

msgid ""
"Your other settings were saved. Cinnamon Clipboard will continue without "
"automatic startup."
msgstr ""
"As demais configurações foram salvas. O Cinnamon Clipboard continuará sem "
"inicialização automática."

#, python-format
msgid "Image (%(width)d×%(height)d px)"
msgstr "Imagem (%(width)d × %(height)d px)"

msgid ""
"Only some files were added to the clipboard because some are no longer "
"available."
msgstr ""
"Somente alguns arquivos foram adicionados à área de transferência porque os "
"demais não estão mais disponíveis."

msgid "The file is no longer available for copying."
msgstr "O arquivo não está mais disponível para cópia."

#, python-format
msgid "%(count)d files are no longer available for copying."
msgstr "%(count)d arquivos não estão mais disponíveis para cópia."

msgid "Cinnamon Clipboard"
msgstr "Área de transferência do Cinnamon"

#, python-format
msgid "File: %(name)s"
msgstr "Arquivo: %(name)s"

#, python-format
msgid "%(name)s and %(count)d more file(s)"
msgstr "%(name)s e mais %(count)d arquivo(s)"

msgid "The image is no longer available for copying."
msgstr "A imagem não está mais disponível para cópia."

msgid "The image could not be copied."
msgstr "Não foi possível copiar a imagem."

msgid "Clipboard manager for Linux desktops."
msgstr "Gerenciador de área de transferência para desktops Linux."

