msgstr "Verificar atualizações ao iniciar:"

#: src/cinnamon_clipboard/ui/preferences_window.py:433
msgid "Check for updates now"
msgstr "Verificar atualizações agora"

#: src/cinnamon_clipboard/ui/preferences_window.py:452
msgid "Updates are managed by APT."
msgstr "As atualizações são gerenciadas pelo APT."

#: src/cinnamon_clipboard/ui/preferences_window.py:462
