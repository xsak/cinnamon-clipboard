msgstr "Вести историю буфера обмена:"

#: src/cinnamon_clipboard/ui/preferences_window.py:129
#: src/cinnamon_clipboard/ui/welcome_window.py:180
msgid "Persistent history"
msgstr "Постоянная история"

#: src/cinnamon_clipboard/ui/preferences_window.py:183
