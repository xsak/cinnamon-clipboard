#: src/cinnamon_clipboard/app.py:262
msgid "Temporary history could not be started"
msgstr "Не удалось запустить временную историю."

#: src/cinnamon_clipboard/app.py:266
msgid ""
"The saved clipboard history could not be deleted. Check file permissions and"
" restart the application."
msgstr ""
"Не удалось удалить сохранённую историю буфера обмена. Проверьте права "
"доступа к файлам и перезапустите приложение."

#: src/cinnamon_clipboard/app.py:286
msgid "Configuration restored"
msgstr "Настройки восстановлены"

#: src/cinnamon_clipboard/app.py:289
msgid ""
"The configuration file contained invalid data and was reset to the default "
"values."
msgstr ""
"Файл настроек содержал недопустимые данные, поэтому настройки сброшены к "
"значениям по умолчанию."

#: src/cinnamon_clipboard/app.py:368
msgid "Automatic startup could not be configured"
msgstr "Не удалось настроить автоматический запуск"

#: src/cinnamon_clipboard/app.py:372
msgid ""
"Your other settings were saved. Cinnamon Clipboard will continue without "
"automatic startup."
msgstr ""
"Остальные настройки сохранены. Cinnamon Clipboard продолжит работу без "
"автоматического запуска."

#: src/cinnamon_clipboard/core/clipboard.py:317
#, python-format
msgid "Image (%(width)d×%(height)d px)"
msgstr "Изображение (%(width)d × %(height)d пикс.)"

#: src/cinnamon_clipboard/core/clipboard.py:399
msgid ""
"Only some files were added to the clipboard because some are no longer "
"available."
msgstr ""
"В буфер обмена добавлены только некоторые файлы, так как остальные больше "
"недоступны."

#: src/cinnamon_clipboard/core/clipboard.py:402
msgid "The file is no longer available for copying."
msgstr "Файл больше недоступен для копирования."

#: src/cinnamon_clipboard/core/clipboard.py:405
#, python-format
msgid "%(count)d files are no longer available for copying."
msgstr "%(count)d файлов больше недоступны для копирования."

#: src/cinnamon_clipboard/core/clipboard.py:409
#: src/cinnamon_clipboard/core/clipboard.py:656
#: src/cinnamon_clipboard/core/clipboard.py:663
#: src/cinnamon_clipboard/ui/main_window.py:15
#: src/cinnamon_clipboard/ui/tray.py:34
msgid "Cinnamon Clipboard"
msgstr "Буфер обмена Cinnamon"

#: src/cinnamon_clipboard/core/clipboard.py:470
#, python-format
msgid "File: %(name)s"
msgstr "Файл: %(name)s"

#: src/cinnamon_clipboard/core/clipboard.py:473
#, python-format
msgid "%(name)s and %(count)d more file(s)"
msgstr "%(name)s и ещё файлов: %(count)d"

#: src/cinnamon_clipboard/core/clipboard.py:657
msgid "The image is no longer available for copying."
msgstr "Изображение больше недоступно для копирования."

#: src/cinnamon_clipboard/core/clipboard.py:664
msgid "The image could not be copied."
msgstr "Не удалось скопировать изображение."

#: src/cinnamon_clipboard/ui/about_window.py:31
msgid "Clipboard manager for Linux desktops."
msgstr "Менеджер буфера обмена для рабочих столов Linux."

#: src/cinnamon_clipboard/ui/about_window.py:56
msgid ""
"Cinnamon Clipboard is free software: you can redistribute it and/or modify "
"it under the terms of the GNU General Public License as published by the "
"Free Software Foundation, either version 3 of the License, or (at your "
"option) any later version.\n"
"\n"
"This program is distributed in the hope that it will be useful, but WITHOUT "
"ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or "
"FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for "
"more details."
msgstr ""
"«Буфер обмена Cinnamon» — свободное программное обеспечение. Вы можете "
"распространять и/или изменять его на условиях GNU General Public License, "
"опубликованной Free Software Foundation, версии 3 либо, по вашему выбору, "
"любой более поздней версии.\n"
"\n"
"Эта программа распространяется в надежде, что она будет полезной, но БЕЗ "
"КАКИХ-ЛИБО ГАРАНТИЙ, включая подразумеваемые гарантии ТОВАРНОЙ ПРИГОДНОСТИ и"
" ПРИГОДНОСТИ ДЛЯ КОНКРЕТНОЙ ЦЕЛИ. Подробнее см. GNU General Public License."

