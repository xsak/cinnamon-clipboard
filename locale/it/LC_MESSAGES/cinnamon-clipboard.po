msgid "Temporary history could not be started"
msgstr "Impossibile avviare la cronologia temporanea."

msgid ""
"The saved clipboard history could not be deleted. Check file permissions and "
"restart the application."
msgstr ""
"Impossibile eliminare la cronologia salvata degli appunti. Controlla i "
"permessi dei file e riavvia l'applicazione."

msgid "Configuration restored"
msgstr "Configurazione ripristinata"

msgid ""
"The configuration file contained invalid data and was reset to the default "
"values."
msgstr ""
"Il file di configurazione conteneva dati non validi ed è stato ripristinato "
"ai valori predefiniti."

msgid "Automatic startup could not be configured"
msgstr "Impossibile configurare l’avvio automatico"

msgid ""
"Your other settings were saved. Cinnamon Clipboard will continue without "
"automatic startup."
msgstr ""
"Le altre impostazioni sono state salvate. Cinnamon Clipboard continuerà "
"senza avvio automatico."

#, python-format
msgid "Image (%(width)d×%(height)d px)"
msgstr "Immagine (%(width)d × %(height)d px)"

msgid ""
"Only some files were added to the clipboard because some are no longer "
"available."
msgstr ""
"Solo alcuni file sono stati aggiunti agli appunti perché gli altri non sono "
"più disponibili."

msgid "The file is no longer available for copying."
msgstr "Il file non è più disponibile per essere copiato."

#, python-format
msgid "%(count)d files are no longer available for copying."
msgstr "%(count)d file non sono più disponibili per essere copiati."

msgid "Cinnamon Clipboard"
msgstr "Appunti di Cinnamon"

#, python-format
msgid "File: %(name)s"
msgstr "File: %(name)s"

#, python-format
msgid "%(name)s and %(count)d more file(s)"
msgstr "%(name)s e altri %(count)d file"

msgid "The image is no longer available for copying."
msgstr "L’immagine non è più disponibile per essere copiata."

msgid "The image could not be copied."
msgstr "Impossibile copiare l'immagine."

msgid "Clipboard manager for Linux desktops."
msgstr "Gestore degli appunti per desktop Linux."

